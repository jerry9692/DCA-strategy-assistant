# Example environment for docker-compose / local docker runs.
# Copy to `.env` and edit. The real `.env` is gitignored.

# Comma-separated list of exact origins allowed by CORS.
# Default is "*" (allow all) — convenient for NAS / intranet deployment.
# For production with a known domain, set to exact origins:
#   DCA_ALLOWED_ORIGINS=https://dca.example.com
#   DCA_ALLOWED_ORIGINS=http://localhost:8010,http://127.0.0.1:8010
DCA_ALLOWED_ORIGINS=*

# SSRF guard for the LLM proxy. Set to 0 to block private / loopback
# addresses (the production-safe default). Set to 1 only when you
# intentionally point the LLM baseUrl at a local proxy.
DCA_LLM_ALLOW_PRIVATE=0
