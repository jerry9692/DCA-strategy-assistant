            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sharperatio"
          },
          "sortinoRatio": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
