            "type": "number",
            "maximum": 0.5,
            "minimum": 0.0,
            "title": "Riskfreerate",
            "description": "Annualized risk-free rate used for Sharpe/Sortino. Default 4% reflects roughly the 2024 short-term US treasury yield.",
            "default": 0.04
          }
        },
        "type": "object",
        "title": "BacktestRequest"
      },
      "BacktestResult": {
        "properties": {
          "symbol": {
            "type": "string",
