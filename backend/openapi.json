  "components": {
    "schemas": {
      "Asset": {
        "properties": {
          "symbol": {
            "type": "string",
            "title": "Symbol"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "currency": {
            "type": "string",
            "title": "Currency",
            "default": "USD"
          }
        },
        "type": "object",
        "required": [
          "symbol",
          "name"
        ],
        "title": "Asset"
      },
      "BacktestMetrics": {
        "properties": {
          "totalInvested": {
            "type": "number",
            "title": "Totalinvested"
          },
          "endingValue": {
            "type": "number",
            "title": "Endingvalue"
          },
          "returnPct": {
            "type": "number",
            "title": "Returnpct"
          },
          "annualizedReturnPct": {
            "type": "number",
            "title": "Annualizedreturnpct"
          },
          "maxDrawdownPct": {
